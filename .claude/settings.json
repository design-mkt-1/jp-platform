{
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "ponytail@ponytail": true,
    "caveman@caveman": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/skill-triggers.mjs 2>/dev/null || node \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-triggers.mjs\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
